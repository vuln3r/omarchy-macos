# omarchy-macos - Ghostty
# Docs: https://ghostty.org/docs/config

# Omarchy "Osaka Jade" - Ghostty does not ship this theme, so spell it out.
# Source: basecamp/omarchy themes/osaka-jade/colors.toml
background = #111c18
foreground = #c1c497
cursor-color = #509475
selection-background = #32473b
selection-foreground = #d6d5bc

# The MacBook screen is P3 - in sRGB the jade renders noticeably duller
window-colorspace = display-p3

palette = 0=#0c1512
palette = 1=#ff5345
palette = 2=#549e6a
palette = 3=#459451
palette = 4=#509475
palette = 5=#d2689c
palette = 6=#2dd5b7
palette = 7=#c1c497
palette = 8=#53685b
palette = 9=#db9f9c
palette = 10=#63b07a
palette = 11=#e5c736
palette = 12=#acd4cf
palette = 13=#75bbb3
palette = 14=#8cd3cb
palette = 15=#d6d5bc

font-family = JetBrainsMono Nerd Font
font-family = JetBrains Mono
font-size = 14
font-thicken = true

# Transparency and blur, the way Omarchy does it
background-opacity = 0.92
background-blur = 20

window-padding-x = 12
window-padding-y = 12
window-padding-balance = true

# No macOS title bar - AeroSpace tiles, the bar would only cost space.
# "hidden" keeps the rounded frame, unlike window-decoration = none. Dragging
# by the top edge is gone with it, which a tiling WM does not need anyway.
macos-titlebar-style = hidden
window-decoration = auto

# Dock icon in the theme colors instead of the official purple
macos-icon = custom-style
macos-icon-ghost-color = #509475
macos-icon-screen-color = #111c18

cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true

copy-on-select = clipboard
confirm-close-surface = false
shell-integration = detect
shell-integration-features = cursor,sudo,title

# New windows and tabs inherit the working directory
window-inherit-working-directory = true

# Treat alt as meta so alt shortcuts do not turn into special characters
macos-option-as-alt = true
