// lyx-theme - fastfetch (Osaka Jade)
// Docs: https://github.com/fastfetch-cli/fastfetch/wiki/Configuration
// Greets every new interactive shell. Keep it short - this runs before the
// first prompt, so every module here is latency you pay on each new window.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    // Jade #509475. The small logo is single-colored, so one entry is enough.
    "source": "macos_small",
    "color": { "1": "38;2;80;148;117" },
    "padding": { "top": 1, "left": 2, "right": 3 }
  },

  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;80;148;117", "title": "38;2;45;213;183" }
  },

  "modules": [
    "title",
    { "type": "os", "key": "os ", "format": "{name} {version}" },
    { "type": "uptime", "key": "up " },
    { "type": "shell", "key": "sh " },
    { "type": "packages", "key": "pkg" },
    { "type": "memory", "key": "mem" },
    "break",
    { "type": "colors", "symbol": "block", "paddingLeft": 2 }
  ]
}
