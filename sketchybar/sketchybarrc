#!/usr/bin/env bash
# lyx-theme — SketchyBar (Osaka Jade)
# Doku: https://felixkratz.github.io/SketchyBar/

PLUGIN_DIR="$CONFIG_DIR/plugins"

source "$CONFIG_DIR/colors.sh"

FONT="JetBrainsMono Nerd Font"

# --- Bar --------------------------------------------------------------------
# notch_*: SketchyBar erkennt das Notch-Display an seiner Hoehe und laesst
# zentrierte Items dort ausweichen. Am externen Monitor (keine Notch) bleibt
# die Uhr exakt mittig — das ist das if/else, ohne eigenes Skript.
# ponytail: notch_display_height ist der 16"-Standardwert und UNGEPRUEFT,
# solange der Deckel zu ist. Stimmt die Hoehe nicht, greift die Ausweich-
# logik am Laptop nicht. Nachmessen: aerospace list-monitors bei offenem
# Deckel, bzw. 'UI Looks like' aus system_profiler SPDisplaysDataType.
sketchybar --bar height=32 \
                 notch_width=200 \
                 notch_display_height=1117 \
                 blur_radius=30 \
                 position=top \
                 sticky=on \
                 padding_left=8 \
                 padding_right=8 \
                 color=$BAR_BG \
                 topmost=window

# --- Defaults ---------------------------------------------------------------
sketchybar --default updates=when_shown \
                     icon.font="$FONT:Bold:14.0" \
                     icon.color=$FG \
                     icon.padding_left=8 \
                     icon.padding_right=4 \
                     label.font="$FONT:Semibold:13.0" \
                     label.color=$FG \
                     label.padding_left=4 \
                     label.padding_right=8 \
                     background.height=24 \
                     background.corner_radius=6 \
                     background.color=$ITEM_BG \
                     background.drawing=off

# --- Links: Apple-Menue -----------------------------------------------------
sketchybar --add item lyx_logo left \
           --set lyx_logo icon="" \
                          icon.font="$FONT:Bold:16.0" \
                          icon.color=$ACCENT \
                          label.drawing=off \
                          padding_right=10 \
                          click_script="open -a 'System Settings'"

# --- Links: AeroSpace-Workspaces --------------------------------------------
# 1-5, passend zu persistent-workspaces in aerospace.toml.
sketchybar --add event aerospace_workspace_change

for sid in 1 2 3 4 5; do
    # --set MUSS vor --subscribe stehen, sonst haengt die Subscription an einem
    # Item, das noch kein script hat, und der Event laeuft ins Leere.
    sketchybar --add item space.$sid left \
               --set space.$sid \
                     icon="$sid" \
                     icon.padding_left=10 \
                     icon.padding_right=10 \
                     label.drawing=off \
                     background.drawing=off \
                     click_script="/opt/homebrew/bin/aerospace workspace $sid" \
                     script="$PLUGIN_DIR/aerospace.sh $sid" \
               --subscribe space.$sid aerospace_workspace_change
done

# --- Links: Fokussierte App -------------------------------------------------
sketchybar --add item front_app left \
           --set front_app icon.drawing=off \
                           label.font="$FONT:Bold:13.0" \
                           label.color=$ACCENT \
                           padding_left=10 \
                           script="$PLUGIN_DIR/front_app.sh" \
           --subscribe front_app front_app_switched

# --- Links: Tyme-Zeiterfassung ----------------------------------------------
# Zeigt Projekt + Laufzeit, solange ein Timer laeuft. Klick oeffnet Tyme.
sketchybar --add item tyme left \
           --set tyme update_freq=30 \
                      padding_left=12 \
                      click_script="open -a Tyme" \
                      script="$PLUGIN_DIR/tyme.sh"

# --- Rechts: Uhr ------------------------------------------------------------
sketchybar --add item clock center \
           --set clock icon="" \
                       icon.color=$ACCENT \
                       background.drawing=on \
                       update_freq=15 \
                       script="$PLUGIN_DIR/clock.sh"

# --- Rechts: Batterie -------------------------------------------------------
sketchybar --add item battery right \
           --set battery update_freq=60 \
                         padding_right=6 \
                         script="$PLUGIN_DIR/battery.sh" \
           --subscribe battery power_source_change system_woke

# --- Rechts: Lautstaerke ----------------------------------------------------
sketchybar --add item volume right \
           --set volume padding_right=6 \
                        script="$PLUGIN_DIR/volume.sh" \
           --subscribe volume volume_change

# --- Rechts: RAM ------------------------------------------------------------
# Bei LM Studio neben Xcode der Wert, der zuerst weh tut. Faerbt sich ab 60%
# gelb, ab 80% rot.
sketchybar --add item memory right \
           --set memory update_freq=15 \
                        padding_right=6 \
                        script="$PLUGIN_DIR/memory.sh"

# --- Rechts: WLAN -----------------------------------------------------------
sketchybar --add item wifi right \
           --set wifi update_freq=30 \
                      padding_right=6 \
                      script="$PLUGIN_DIR/wifi.sh" \
           --subscribe wifi wifi_change

sketchybar --update
