#!/usr/bin/env bash
# lyx-theme - SketchyBar (Osaka Jade)
# Docs: https://felixkratz.github.io/SketchyBar/

PLUGIN_DIR="$CONFIG_DIR/plugins"

source "$CONFIG_DIR/colors.sh"

FONT="JetBrainsMono Nerd Font"

# --- Bar --------------------------------------------------------------------
# notch_*: SketchyBar recognises the notched display by its height and makes
# centered items dodge the notch there. On an external monitor (no notch) the
# clock stays exactly centered - that is the if/else, without a script.
# ponytail: notch_display_height is the 16" default value and UNVERIFIED as
# long as the lid is closed. If the height is wrong the dodging never kicks in
# on the laptop. Measure it with the lid open: 'UI Looks like' from
# system_profiler SPDisplaysDataType.
sketchybar --bar height=32 \
                 notch_width=200 \
                 notch_display_height=1117 \
                 blur_radius=30 \
                 position=top \
                 sticky=on \
                 padding_left=8 \
                 padding_right=8 \
                 color=$BAR_BG \
                 topmost=window

# --- Defaults ---------------------------------------------------------------
sketchybar --default updates=when_shown \
                     icon.font="$FONT:Bold:14.0" \
                     icon.color=$FG \
                     icon.padding_left=8 \
                     icon.padding_right=4 \
                     label.font="$FONT:Semibold:13.0" \
                     label.color=$FG \
                     label.padding_left=4 \
                     label.padding_right=8 \
                     background.height=24 \
                     background.corner_radius=6 \
                     background.color=$ITEM_BG \
                     background.drawing=off

# --- Left: Apple menu -------------------------------------------------------
sketchybar --add item lyx_logo left \
           --set lyx_logo icon="" \
                          icon.font="$FONT:Bold:16.0" \
                          icon.color=$ACCENT \
                          label.drawing=off \
                          padding_right=10 \
                          click_script="open -a 'System Settings'"

# --- Left: AeroSpace workspaces ---------------------------------------------
# 1-5, matching persistent-workspaces in aerospace.toml.
sketchybar --add event aerospace_workspace_change

for sid in 1 2 3 4 5; do
    # --set MUST come before --subscribe, otherwise the subscription attaches
    # to an item that has no script yet and the event goes nowhere.
    sketchybar --add item space.$sid left \
               --set space.$sid \
                     icon="$sid" \
                     icon.padding_left=10 \
                     icon.padding_right=10 \
                     label.drawing=off \
                     background.drawing=off \
                     click_script="/opt/homebrew/bin/aerospace workspace $sid" \
                     script="$PLUGIN_DIR/aerospace.sh $sid" \
               --subscribe space.$sid aerospace_workspace_change
done

# --- Left: focused app ------------------------------------------------------
sketchybar --add item front_app left \
           --set front_app icon.drawing=off \
                           label.font="$FONT:Bold:13.0" \
                           label.color=$ACCENT \
                           padding_left=10 \
                           script="$PLUGIN_DIR/front_app.sh" \
           --subscribe front_app front_app_switched

# --- Left: Tyme time tracking -----------------------------------------------
# Shows project and elapsed time while a timer runs. Click opens Tyme.
sketchybar --add item tyme left \
           --set tyme update_freq=30 \
                      padding_left=12 \
                      click_script="open -a Tyme" \
                      script="$PLUGIN_DIR/tyme.sh"

# --- Center: clock ----------------------------------------------------------
sketchybar --add item clock center \
           --set clock icon="" \
                       icon.color=$ACCENT \
                       background.drawing=on \
                       update_freq=15 \
                       script="$PLUGIN_DIR/clock.sh"

# --- Right: battery ---------------------------------------------------------
sketchybar --add item battery right \
           --set battery update_freq=60 \
                         padding_right=6 \
                         script="$PLUGIN_DIR/battery.sh" \
           --subscribe battery power_source_change system_woke

# --- Right: volume ----------------------------------------------------------
# update_freq so that plugging headphones in or out is noticed even when it
# does not come with a volume change.
sketchybar --add item volume right \
           --set volume update_freq=10 \
                        padding_right=6 \
                        script="$PLUGIN_DIR/volume.sh" \
           --subscribe volume volume_change

# --- Right: memory ----------------------------------------------------------
# Turns yellow above 60% and red above 80%.
sketchybar --add item memory right \
           --set memory update_freq=15 \
                        padding_right=6 \
                        script="$PLUGIN_DIR/memory.sh"

# --- Right: Tailscale -------------------------------------------------------
sketchybar --add item tailscale right \
           --set tailscale update_freq=15 \
                           padding_right=6 \
                           click_script="open -a Tailscale" \
                           script="$PLUGIN_DIR/tailscale.sh"

# --- Right: Wi-Fi -----------------------------------------------------------
sketchybar --add item wifi right \
           --set wifi update_freq=30 \
                      padding_right=6 \
                      script="$PLUGIN_DIR/wifi.sh" \
           --subscribe wifi wifi_change

sketchybar --update
